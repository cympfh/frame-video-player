{
  "controller_type": "knuckles",
  "name": "frame-video-player",
  "bindings": {
    "/actions/fvp": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/fvp/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/fvp/in/scroll"
            }
          }
        }
      ]
    }
  },
  "app_key": "cympfh.frame-video-player"
}