{
  "controller_type": "frame_controller",
  "name": "frame-video-player",
  "bindings": {
    "/actions/fvp": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/fvp/in/right_stick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_left",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/fvp/in/seek_back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/fvp/in/seek_fwd"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/fvp/in/play_pause"
            }
          }
        }
      ]
    }
  }
}
